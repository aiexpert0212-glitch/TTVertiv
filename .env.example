# 이 파일을 .env 로 복사한 뒤 값을 입력하세요 (.env는 외부에 공유하지 마세요)
PORT=3000

# 저장된 비교 DB — 둘 다 있으면 Supabase, 없으면 로컬 SQLite(data/vss.db)
SUPABASE_URL=
# Supabase 대시보드 → Project Settings → API Keys
#   publishable 키(sb_publishable_...): supabase/schema.sql 의 anon 정책 필요 (누구나 접근 가능, 테스트용)
#   secret 키(sb_secret_...): 서버 전용, 정책 없이도 동작 (실데이터 권장)
SUPABASE_KEY=

# (선택) Claude AI 연동 — 비워 두면 규칙 기반 데모 모드
ANTHROPIC_API_KEY=
